# ── CADIS ML Backend (FastAPI) ───────────────────────────────

# App metadata
APP_TITLE=CADIS API
APP_VERSION=1.0.0
DEBUG=false

# GLiNER zero-shot NER model
GLINER_MODEL_ID=urchade/gliner_base

# Sentence embedding model for ChromaDB
EMBEDDER_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# Vision-Language Model (requires GPU with >=16GB VRAM)
VLM_ENABLED=false
VLM_MODEL_ID=Qwen/Qwen-VL-Chat

# ChromaDB vector store
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_DEFAULT_COLLECTION=cadis_documents

# Unstructured.io document parsing strategy: "fast" | "hi_res" | "ocr_only"
UNSTRUCTURED_STRATEGY=fast
UNSTRUCTURED_EXTRACT_IMAGES=true

# Max file upload size in MB
MAX_UPLOAD_MB=50
